services:
  rag-fastapi:
    build: ./rag
    container_name: rag-fastapi
    ports:
      - "8000:8000"
    environment:
      - OLLAMA_HOST=http://host.docker.internal:11434
    volumes:
      - ./data:/app/data
      - ./chroma_db:/app/chroma_db
    extra_hosts:
      - "host.docker.internal:host-gateway"
    restart: unless-stopped

  rag-backend:
    build: ./backend
    container_name: rag-backend
    ports:
      - "8080:8080"
    environment:
      - SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/rag_assistant
      - SPRING_DATASOURCE_USERNAME=rag_user
      - SPRING_DATASOURCE_PASSWORD=rag_password
      - AI_SERVICE_URL=http://rag-fastapi:8000
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
      - rag-fastapi
    restart: unless-stopped

  frontend:
    build: ./frontend
    container_name: rag-frontend
    ports:
      - "3000:80"
    environment:
      - VITE_API_BASE_URL=http://localhost:8080
    depends_on:
      - rag-backend
    restart: unless-stopped